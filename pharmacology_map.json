 "gaps": [
  {
   "title": "Antibiotics",
   "why": "Penicillins, cephalosporins, aminoglycosides, macrolides and others. Usually a large share of any nursing pharmacology exam.",
   "level": "critical"
  },
  {
   "title": "Antimalarials",
   "why": "Very relevant in Ethiopia. Her Med-Surg folder has malaria slides, but no drug lecture here.",
   "level": "critical"
  },
  {
   "title": "Antiretrovirals (HIV)",
   "why": "ART regimens and side effects. High priority in Ethiopian curricula.",
   "level": "critical"
  },
  {
   "title": "Endocrine drugs",
   "why": "Insulin, oral antidiabetics, thyroid drugs, corticosteroids.",
   "level": "critical"
  },
  {
   "title": "Blood drugs",
   "why": "Anticoagulants (heparin, warfarin), iron, folic acid, vitamin B12.",
   "level": "important"
  },
  {
   "title": "Antifungals, anthelmintics, antiprotozoals",
   "why": "Common in community health questions too.",
   "level": "important"
  },
  {
   "title": "Respiratory drugs",
   "why": "Partly covered: β2 agonists and ipratropium are in the ANS file. Steroid inhalers and theophylline are missing.",
   "level": "partial"
  },
  {
   "title": "Uterine & obstetric drugs",
   "why": "Oxytocin, magnesium sulfate. Check whether her Maternity files cover them.",
   "level": "check"
  },
  {
   "title": "Dose calculation & medication administration",
   "why": "Nursing-specific: rights of administration, IV drip rates, pediatric doses.",
   "level": "important"
  }
 ],
 "overlaps": [
  {
   "a": "GEN_PPT",
   "b": "GEN_PDF",
   "what": "Both cover the whole of general pharmacology. Study from the slides; use the PDF for its routes-of-administration section."
  },
  {
   "a": "CNS_PPT",
   "b": "CNS_PDF",
   "what": "The PDF is a 45-page summary of the 277-slide deck. Learn from the slides, revise from the summary."
